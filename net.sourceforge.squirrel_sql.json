    {
      "name": "squirrelsql",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/squirrelsql",
        "cp -r * /app/squirrelsql"
      ],
      "sources": [{
        "type": "archive",
        "url": "https://github.com/squirrel-sql-client/squirrel-sql-stable-releases/releases/download/5.1.0-a_plainzip/squirrelsql-5.1.0-optional.zip",
